{
  "version": 2,
  "functions": {
    "api/generate.js": { "maxDuration": 60 },
    "api/health.js":   { "maxDuration": 15 },
    "api/posts.js":    { "maxDuration": 15 }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/",         "dest": "/dashboard/index.html" },
    { "src": "/(.*)",     "dest": "/dashboard/index.html" }
  ],
  "crons": [
    { "path": "/api/generate", "schedule": "0 8 * * *" }
  ],
  "env": {
    "SUPABASE_URL":      "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key"
  }
}
